rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }

    // Path:
    // complaints/{uid}/{complaintId}/{fileName}

    match /complaints/{uid}/{complaintId}/{fileName} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      // Maximum 50 MiB per file.
      // Files are uploaded without resizing or compression.

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;

      allow delete: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      // Existing files cannot be overwritten.

      allow update: if false;
    }
  }
}